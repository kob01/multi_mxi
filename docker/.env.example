# ==========================================================================
# 容器侧配置模板 —— 复制为 `docker/.env` 后修改 (cp docker/.env.example docker/.env)
#
# 双重身份:
#   1) compose 插值源 (项目目录 = docker/, 供 ${VAR:-default} 读取);
#   2) 以 env_file 形式注入 assistant / hr-mcp / finance-mcp / hr-agent / finance-agent
#      五个应用服务的真实环境变量。
# app/config.py 不读本文件, 所以这里的地址一律是"容器视角"(compose 服务名 + 容器内端口
# + /data 卷路径), 不得混入 localhost 宿主地址。
#
# 密钥红线: 真实密钥不写本文件。容器内从 /run/secrets/<name> 读取, 对应文件由
# docker/docker-compose.yml 的 secrets 段挂载, 源在 docker/secrets/<name>.txt
# (已被 .gitignore 排除; 目录内只提交 README.md)。
# ==========================================================================

# ---------- 镜像与宿主端口 (仅供 compose 插值, 应用不读) ----------
# 国内镜像源, 换机/换网络时可覆盖
BASE_IMAGE=docker.m.daocloud.io/library/python:3.11-slim
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PG_IMAGE=docker.m.daocloud.io/pgvector/pgvector:pg16
ES_IMAGE=docker.m.daocloud.io/library/elasticsearch:8.15.3
REDIS_IMAGE=docker.m.daocloud.io/redis/redis-stack-server:7.4.0-v3
NEO4J_IMAGE=docker.m.daocloud.io/library/neo4j:5-community
MONGO_IMAGE=docker.m.daocloud.io/library/mongo:7.0
# TEI 按 GPU 架构选: sm_89(Ada/RTX 40 系)=89-1.9; 无 GPU 或启动失败退 cpu-1.9
TEI_IMAGE=ghcr.m.daocloud.io/huggingface/text-embeddings-inference:89-1.9
# Langfuse 自托管可观测栈(profile=langfuse, 默认不起)的镜像: 走 daocloud 镜像源;
# minio 的 docker hub 仓已下架, 故取 quay。升版只改这几个键。
LANGFUSE_IMAGE=docker.m.daocloud.io/langfuse/langfuse:4
LANGFUSE_WORKER_IMAGE=docker.m.daocloud.io/langfuse/langfuse-worker:4
LANGFUSE_CLICKHOUSE_IMAGE=docker.m.daocloud.io/clickhouse/clickhouse-server:25.12
LANGFUSE_PG_IMAGE=docker.m.daocloud.io/library/postgres:16
LANGFUSE_REDIS_IMAGE=docker.m.daocloud.io/library/redis:7
LANGFUSE_MINIO_IMAGE=quay.m.daocloud.io/minio/minio:RELEASE.2025-04-22T22-12-26Z
# 宿主发布端口: Windows winnat/Hyper-V 开机时会把整段端口列进 TCP 排除范围,
# 段内端口即使无人监听也无法 bind (查: netsh int ipv4 show excludedportrange protocol=tcp)。
# 排除段内容**每次开机都变**, 别把某端口记成永久可用: 本机两次实测分别为
# 7254-7353/7354-7453/7454-7553/7554-7653/7956-8055 与 7137-7236/7237-7336/7530-7629/7630-7729。
# 这里只抬**宿主发布端口**; 容器内监听端口与 compose 网络内的服务名地址不变。
# 未抬(保持 1:1 原值): postgres 5432 / ES 9200 / Mongo 27017 / mineru 8888 /
# tei-rerank 8080 / hr-agent 9001 / finance-agent 9002。
# (Redis 已从"未抬"移入下方 REDIS_HOST_PORT: 6379 已被本机排除段 6334-6433 吞掉)
ASSISTANT_HOST_PORT=18000
HR_MCP_HOST_PORT=18001
FINANCE_MCP_HOST_PORT=18002
# 数据洞察 MCP(容器内监听 8005)与采购合同 MCP(容器内监听 8006)的宿主发布端口。
ANALYTICS_MCP_HOST_PORT=18005
PROCUREMENT_MCP_HOST_PORT=18006
# Langfuse Web UI 的宿主发布端口(容器内恒监听 3000)。改这个端口时要同步改
# docker-compose.yml 里 langfuse-web 的 NEXTAUTH_URL 默认值(它是浏览器实际打开
# 的地址, 不一致会登录后 401); NEXTAUTH_URL 含 localhost, 故意不进本文件 ——
# env-check 把本文件里的 localhost 地址判为容器轨污染。
LANGFUSE_WEB_HOST_PORT=18100
# neo4j 两个协议端口都要发: HTTP 给 Browser, Bolt 给 driver(图记忆/知识图谱实际用的就这个)
NEO4J_HTTP_HOST_PORT=17474
# bolt 默认 7687 已在本机新排除段 7630-7729 里, 保持原值会使 neo4j Exited(255)
# (下游还会表现为其他容器报 Failed to DNS resolve address neo4j:7687); 抬到 17687。
NEO4J_BOLT_HOST_PORT=17687
# redis-stack-server 宿主发布端口(容器内监听恒为 6379, compose 网络内仍写 redis://redis:6379)。
# 6379 已落进本机 winnat 排除段 6334-6433, 保持原值会使 redis Exited(255),
# 记忆层/缓存层静默退回内存(无异常栈), 且下游报 Failed to DNS resolve address redis:6379。
REDIS_HOST_PORT=16379
# TEI 监听端口与宿主发布端口一致(容器启动参数 --port 8080), 所以容器内写
# http://tei-rerank:8080、宿主写 http://localhost:8080, 两头同一位数。
TEI_PORT=8080

# ---------- Ollama (仅 embedding / vision 走宿主机) ----------
# 容器内 localhost 指向容器自身, 必须经 host.docker.internal 访问宿主机 Ollama
# (CONFIG_RULES.md 第 1 条红线: 此行不得改成 localhost)
OLLAMA_BASE_URL=http://host.docker.internal:11434
EMBEDDING_MODEL=bge-m3

# ---------- 在线 LLM (DeepSeek / 智谱 GLM / ... 经供应商注册表路由) ----------
# DEEPSEEK_API_KEY / ZHIPU_API_KEY 不写本文件: 容器内读 /run/secrets/<name>
# (compose 已挂载 zhipu_api_key secret; 切 GLM 前先把真密钥写入 docker/secrets/zhipu_api_key.txt)
DEEPSEEK_BASE_URL=https://api.deepseek.com
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 整站模型切换只改这两行(经 compose 注入各容器, 无需重建镜像):
# deepseek-flash / glm-5.3-flash / 任意宿主机 Ollama 模型名(未命中注册表即走 Ollama)
LLM_MODEL=deepseek-flash
INTENT_MODEL=deepseek-flash
# 在线 LLM 请求上限与重试次数: 没有墙钟上限的挂死调用会永久占住一个并发闸门;
# 重试取小(供商 429/5xx 时重试风暴只会把故障放大)。与宿主轨同名同值。
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
# 供应商注册表(模型前缀 -> 路由), 可选键: 留空/删行即用 config.py 内置默认表
# (已含 deepseek/glm 两项)。新增 OpenAI 兼容供应商 = 加前缀条目 + base_url 键
# + compose 挂载 docker/secrets/<api_key_field>.txt; 密钥红线: api_key_field 只写字段名。
LLM_PROVIDERS_JSON=

# ---------- RAG ----------
# 镜像 WORKDIR=/srv, 写 ./data/knowledge 会解析到构建时 COPY 的快照,
# 新增语料不重建镜像就读不到 —— 容器侧必须用持久卷(/data)里的绝对路径。
KNOWLEDGE_DIR=/data/knowledge
RAG_TOP_K=8
RERANK_TOP_N=4
RETRIEVAL_SCORE_THRESHOLD=0.4
RAG_INCREMENTAL_INGEST=true
# 同网络内的 TEI 重排服务
TEI_RERANK_URL=http://tei-rerank:8080

# ---------- Elasticsearch (同网络服务名) ----------
ES_URL=http://elasticsearch:9200
ES_INDEX=kb_chunks

# ---------- Assistant ----------
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8000
MEMORY_MAX_TURNS=10
MEMORY_SUMMARY_THRESHOLD=20
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
STREAM_BUFFER_TTL=600
# 多智能体并发委派(显式点选): MULTI_AGENT_ENABLED=false 即忽略 agent_targets, 完全回退单意图路由
MULTI_AGENT_ENABLED=true
MULTI_AGENT_MAX_TARGETS=3
MULTI_AGENT_PARALLELISM=2
MULTI_AGENT_TIMEOUT=150
MULTI_AGENT_ANSWER_CHARS=4000
# 同步活下沉的线程池上限(asyncio.to_thread 默认 min(32,cpu+4), anyio 默认 40):
# 文档生成/文档解析/PIL 图片归一化与文件下载路由全走这两个池。
THREAD_POOL_TOKENS=64

# ---------- 并发容量: 连接池与下游上限(与 PG max_connections 一起算账) ----------
# 与宿主轨 .env 同名同值(两侧不同值 = 容器与宿主脚本结论不可互复现)。本段靠 compose
# 的 env_file 整份注入容器, 不需在 environment: 里新增键(那些只放红线地址/卷路径)。
# 调大 PG_*_POOL* 时必须回来对照 docker-compose.yml 里 postgres 的 max_connections=200。
REDIS_MAX_CONNECTIONS=100
# ES 检索侧秒级超时与稀疏通道并发上限(重建另走宽松一档)
ES_SEARCH_TIMEOUT=3
ES_SEARCH_CONCURRENCY=32
ES_REBUILD_TIMEOUT=120
# Ollama embedding: 查询档(热路径)与批量档(入库)共用一个连接池
EMBEDDING_TIMEOUT=60
EMBEDDING_QUERY_TIMEOUT=10
EMBEDDING_MAX_CONNECTIONS=32
EMBEDDING_QUERY_CONCURRENCY=8
# MCP 工具清单缓存 TTL: 每次 tool_call 都重新 discover 会打满 MCP server
MCP_TOOLS_TTL=300
# A2A 委派超时与共享连接池上限
A2A_TIMEOUT=120
A2A_CONNECT_TIMEOUT=10
A2A_MAX_CONNECTIONS=64
A2A_MAX_KEEPALIVE=16
# SSE 缓冲区与背压闸门: 超上限直接 503(+Retry-After), 而不是让所有人集体超时
STREAM_MAX_EVENTS=4000
STREAM_MAX_CONCURRENT_RUNS=200
STREAM_MAX_BUFFERS=2000
# Redis 不可用时降级为进程内会话记忆的会话数上限(LRU 淘汰, 防无界涨内存)
SESSION_MEMORY_LOCAL_MAX=5000
DOC_KG_ENABLED=true
# 单篇文档落库的关系条数硬上限(与宿主 .env.example 同值)
KG_MAX_RELATIONS_PER_DOC=40
# 受控关系词表开关: false 即退回关系词原样入库(词表本体在 app/kg/vocab.py)
KG_RELATION_VOCAB_ENABLED=true

# ---------- 记忆层 / 缓存层 (redis-stack-server) ----------
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
# 宿主直连时用上面 REDIS_HOST_PORT 的发布端口(根 .env 写 redis://localhost:16379/0)。
SESSION_MEMORY_TTL=3600
CHECKPOINT_ENABLED=true

# ---------- 长期记忆: Graph 通道 (neo4j, NEO4J_AUTH=none 故无需账号) ----------
LONG_TERM_MEMORY_ENABLED=true
GRAPH_MEMORY_ENABLED=true
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=
NEO4J_PASSWORD=

# ---------- 个人级记忆 (与宿主侧 .env 同参数, 保证两侧结论可互相复现) ----------
PERSONAL_MEMORY_ENABLED=true
PROFILE_MAX_CHARS=400
PROFILE_HISTORY_MAX_ENTRIES=10
PROFILE_CURRENT_GRACE_DAYS=90
MEMORY_PREFERENCE_TOP_K=3
MEMORY_HABIT_TOP_K=3
MEMORY_EPISODE_TOP_K=2
MEMORY_KNOWLEDGE_TOP_K=3
EPISODIC_WINDOW_DAYS=30
MEMORY_DECAY_DAYS=90
MEMORY_REFLECT_MIN_EPISODES=3
MEMORY_OBSERVATION_WINDOW_DAYS=7
# 显式知识记录(知识桶唯一写入口): 命中触发词才提炼落库; 情节蒸馏已下线, 上项仅保留兼容。
MEMORY_RECORD_ENABLED=true
MEMORY_RECORD_KEYWORDS=记一下,记住,帮我记,记下来,别忘了

# ---------- 缓存层 TTL ----------
CACHE_ENABLED=true
PROMPT_CACHE_TTL=300
RETRIEVAL_CACHE_TTL=300
TOOL_CACHE_TTL=30

# ---------- MCP Servers / A2A Agents (容器内全部用 compose 服务名) ----------
HR_MCP_URL=http://hr-mcp:8001/mcp
FINANCE_MCP_URL=http://finance-mcp:8002/mcp
ANALYTICS_MCP_URL=http://analytics-mcp:8005/mcp
PROCUREMENT_MCP_URL=http://procurement-mcp:8006/mcp
HR_AGENT_URL=http://hr-agent:9001
FINANCE_AGENT_URL=http://finance-agent:9002
ANALYST_AGENT_URL=http://analyst-agent:9005
CONTRACT_AGENT_URL=http://contract-agent:9006

# ---------- 进程内 web 工具 / 文档生成 (app/tools, 无新容器/端口) ----------
# tavily/serper 密钥只写 docker/secrets/<name>.txt 挂载到 /run/secrets, 这里留空。
WEB_SEARCH_PROVIDER=ddgs
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_CACHE_TTL=300
# 检索出口代理(仅作用于 search_web, 不作用于 fetch_url): 大陆网络下 ddgs 默认引擎直连不可达。
# 容器内用 http://host.docker.internal:<port> 指向宿主代理(需开启 Allow LAN); 不受限网络留空。
WEB_SEARCH_PROXY=
TAVILY_API_KEY=
SERPER_API_KEY=
WEB_FETCH_ALLOWLIST=
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=8000
WEB_FETCH_MAX_REDIRECTS=3
DOCGEN_MAX_BYTES=20000000
DOCGEN_RETENTION_HOURS=24
# 文档内嵌图片治理: 单张原图字节上限 + 归一化后最长边像素。
DOCGEN_IMAGE_MAX_BYTES=8000000
DOCGEN_IMAGE_MAX_EDGE=1600
# 下载链接前缀: 空 = 相对路径(SPA 同源可直接点)。
PUBLIC_BASE_URL=

# ---------- 分析产物 (图表/报告落盘目录, 容器侧必须是 /data 卷内路径) ----------
# 与 UPLOAD_DIR 同理: ./data/reports 会落在容器工作目录 /srv, 重建即丢。
REPORT_DIR=/data/reports

# ---------- Security ----------
# 审计日志落持久卷(../logs:/data/logs); 写 ./logs/... 会落在容器工作目录 /srv/logs,
# 容器重建即丢合规留痕。
AUDIT_LOG_PATH=/data/logs/audit.jsonl

# ---------- LangSmith / LangGraph Studio ----------
# 合规红线: 容器侧强制 false —— 开启后对话内容会上传到 LangSmith 云端。
# LANGSMITH_API_KEY 不进本文件: 容器内读 /run/secrets/langsmith_api_key。
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=mxi-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Langfuse (自托管可观测, 与 LangSmith 并存的独立开关) ----------
# 与 LangSmith 的区别: 上报目标是同 compose 网络内自建的 langfuse-web(见
# docker-compose.yml 的 profile=langfuse 栈), 对话数据不出本机, 所以容器侧允许开。
# 开启步骤: 1) --profile langfuse 起栈 -> 2) 浏览器进 http://localhost:18100 建项目拿
# pk/sk -> 3) 写 docker/secrets/langfuse_api_key.txt(两行: sk / pk) ->
# 4) 本键置 true 并重建/重启 assistant 容器。不用时保持 false(一个容器都不起)。
# LANGFUSE_API_KEY / 项目 public key 不进本文件: 容器内读 /run/secrets/langfuse_api_key。
# LANGFUSE_BASE_URL 也不写本文件: compose environment 已用服务名 langfuse-web 锁死。
LANGFUSE_ENABLED=false
LANGFUSE_PROJECT=mxi-assistant
# trace 环境标签(映射 LANGFUSE_TRACING_ENVIRONMENT): 同一项目里区分
# development/staging/production; 只允许小写字母/数字/-/_, 不得以 langfuse 开头。
LANGFUSE_ENVIRONMENT=development

# ---------- 统一存储层: PostgreSQL ----------
# 密码不写本文件: 由 compose secrets 挂载 /run/secrets/pg_password
# 主机名必须用 compose 服务名 postgres (非 localhost): 容器内 localhost 指向容器自身。
PG_HOST=postgres
PG_PORT=5432
PG_USER=mxi
PG_DATABASE=mxi
PG_SSLMODE=disable
PG_CONNECT_TIMEOUT=10
# 连接池容量: 不给就是 SQLAlchemy 默认 5+10(=15 条), 百人共用一个进程时所有 DB
# 路径都在这排 30s 队然后被代码当"DB 抖动"吞掉。同步池取小是因为它是"网关 + 每个
# mcp/agent 容器各建一份"这份预算里的乘数项。
PG_POOL_SIZE=30
PG_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=15
PG_SYNC_POOL_SIZE=5
PG_SYNC_MAX_OVERFLOW=5
PG_STATEMENT_TIMEOUT_MS=5000
EMBEDDING_DIM=1024
UPSERT_BATCH_SIZE=500

# ---------- 文档上传 ----------
UPLOAD_DIR=/data/uploads
UPLOAD_MAX_MB=50
PARENT_CHUNK_MAX=1200

# ---------- 文档正文外置存储: MongoDB ----------
MONGO_ENABLED=true
MONGO_URL=mongodb://mongo:27017
MONGO_DATABASE=mxi
MONGO_MAX_POOL_SIZE=50
MONGO_SERVER_SELECTION_MS=3000
MONGO_BODY_MAX_BYTES=15000000
MONGO_BATCH_PAGE_SIZE=500

# ---------- 文本规范化 ----------
NORMALIZER_VERSION=n1

# ---------- MinerU OCR (compose 内 profile=mineru 的服务, 直接用服务名) ----------
# 若要改回宿主机自跑的 mineru-api: http://host.docker.internal:8888
MINERU_BASE_URL=http://mineru:8888
MINERU_BACKEND=pipeline
MINERU_TIMEOUT=300
