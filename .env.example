# ==========================================================================
# 宿主侧配置模板 —— 复制为仓根 `.env` 后按机器实况修改 (cp .env.example .env)
#
# 本文件是"宿主机视角": app/config.py 只读 .env 与 .env.local(机器私有覆盖), 不读
# docker/.env, 所以这里的地址全部指向 docker compose 已发布的宿主端口。
# 容器侧配置(服务名 + /data 卷路径)见 docker/.env.example -> docker/.env。
#
# 密钥红线: 真实密钥不得写在本文件。DEEPSEEK_API_KEY / LANGSMITH_API_KEY / PG_PASSWORD
# 只来自 docker/secrets/<name>.txt (config.py 在宿主机直跑时回退读取) 或真实环境变量。
# 即使本文件被复制/备份, 也不会带走任何凭据。
# ==========================================================================

# ---------- Ollama (仅 embedding / vision 走宿主机; rerank 已迁 TEI) ----------
# 本系统唯一不在 docker 里的依赖
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# ---------- DeepSeek 在线 API (LLM / 意图识别) ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 禁止在此填值: 写 docker/secrets/deepseek_api_key.txt (或 export DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=
LLM_MODEL=deepseek-flash
INTENT_MODEL=deepseek-flash

# ---------- RAG ----------
KNOWLEDGE_DIR=./data/knowledge
RAG_TOP_K=8
RERANK_TOP_N=4
# compose 服务 tei-rerank 的已发布宿主端口; 权重需预下载到 data/tei_models (见 README)
TEI_RERANK_URL=http://localhost:8080
RETRIEVAL_SCORE_THRESHOLD=0.4

# ---------- Elasticsearch (compose 服务 elasticsearch 的宿主端口) ----------
ES_URL=http://localhost:9200
ES_INDEX=kb_chunks

# ---------- Assistant ----------
ASSISTANT_HOST=0.0.0.0
# 宿主直跑网关的端口, 与 compose 里 assistant 的发布端口保持一致(默认 18000)。
# Windows winnat/Hyper-V 会把 7956-8055 等端口段列进 TCP 排除范围, :8000 常常无法 bind,
# 详见 docker/docker-compose.yml 顶部约定。vite 代理目标读的就是这个值。
ASSISTANT_PORT=18000
MEMORY_MAX_TURNS=10
MEMORY_SUMMARY_THRESHOLD=20
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
STREAM_BUFFER_TTL=600

# ---------- 记忆层: Session Memory / Working State Checkpoint (compose 服务 redis) ----------
# redis 必须是 redis-stack-server(带 RedisJSON + RediSearch), 否则 checkpointer 静默退回内存
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
SESSION_MEMORY_TTL=3600
CHECKPOINT_ENABLED=true

# ---------- 长期记忆: Vector(pgvector) + Graph(compose 服务 neo4j) ----------
LONG_TERM_MEMORY_ENABLED=true
GRAPH_MEMORY_ENABLED=true
# 对接 compose 服务 neo4j 的已发布 bolt 端口 (原 7687 已落进本机 winnat 排除段 7630-7729,
# 由 docker/.env 的 NEO4J_BOLT_HOST_PORT 抬到 17687; HTTP 控制台在 17474)
NEO4J_URI=bolt://localhost:17687
# NEO4J_AUTH=none 时留空
NEO4J_USER=
NEO4J_PASSWORD=

# ---------- 个人级记忆 ----------
PERSONAL_MEMORY_ENABLED=true
PROFILE_MAX_CHARS=400
MEMORY_PREFERENCE_TOP_K=3
MEMORY_HABIT_TOP_K=3
MEMORY_EPISODE_TOP_K=2
MEMORY_KNOWLEDGE_TOP_K=3
EPISODIC_WINDOW_DAYS=30
MEMORY_DECAY_DAYS=90
MEMORY_REFLECT_MIN_EPISODES=3

# ---------- 缓存层 ----------
CACHE_ENABLED=true
PROMPT_CACHE_TTL=300
RETRIEVAL_CACHE_TTL=300
TOOL_CACHE_TTL=30

# ---------- MCP Servers / A2A Agents (compose 已发布宿主端口) ----------
HR_MCP_URL=http://localhost:18001/mcp
FINANCE_MCP_URL=http://localhost:18002/mcp
ANALYTICS_MCP_URL=http://localhost:18005/mcp
PROCUREMENT_MCP_URL=http://localhost:18006/mcp
HR_AGENT_URL=http://localhost:9001
FINANCE_AGENT_URL=http://localhost:9002
ANALYST_AGENT_URL=http://localhost:9005
CONTRACT_AGENT_URL=http://localhost:9006

# ---------- 分析产物 (Analyst_Agent 图表/报告) ----------
# 宿主直跑网关时读 ./data/reports; 与容器侧 /data/reports 同一 ../data 卷。
REPORT_DIR=./data/reports

# ---------- Security ----------
AUDIT_LOG_PATH=./logs/audit.jsonl

# ---------- LangSmith / LangGraph Studio (仅开发机按需开启) ----------
# 开启后对话 trace 会上传到 LangSmith 云端; 容器侧由 docker/.env + compose 锁死 false。
LANGSMITH_TRACING=false
# 禁止在此填值: 写 docker/secrets/langsmith_api_key.txt (或 export LANGSMITH_API_KEY)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mxi-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- 统一存储层: PostgreSQL (compose 服务 postgres) ----------
# 密码不填本文件: 走 docker/secrets/pg_password.txt 或环境变量 PG_PASSWORD
# DATABASE_URL 非空时优先于下面的 PG_* 字段 (必须为 postgresql+asyncpg://...)
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=mxi
PG_DATABASE=mxi
PG_SSLMODE=disable
PG_CONNECT_TIMEOUT=10
PG_STATEMENT_TIMEOUT_MS=5000
EMBEDDING_DIM=1024
UPSERT_BATCH_SIZE=500

# ---------- 文档上传 ----------
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=50
PARENT_CHUNK_MAX=1200

# ---------- 文档正文外置存储: MongoDB (compose 服务 mongo) ----------
MONGO_ENABLED=true
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=mxi
MONGO_MAX_POOL_SIZE=50
MONGO_SERVER_SELECTION_MS=3000
MONGO_BODY_MAX_BYTES=15000000
MONGO_BATCH_PAGE_SIZE=500

# ---------- 入库 ----------
# normalize_text() 行为变更时必须递增此值 (否则已入库 offset 集体失效)
NORMALIZER_VERSION=n1
RAG_INCREMENTAL_INGEST=true
# 文档知识图谱(GraphRAG)总开关, 复用 neo4j
DOC_KG_ENABLED=true

# ---------- MinerU OCR (compose 服务 mineru, 需 --profile mineru 启动) ----------
MINERU_BASE_URL=http://localhost:8888
MINERU_BACKEND=pipeline
MINERU_TIMEOUT=300
