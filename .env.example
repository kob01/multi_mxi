# ==========================================================================
# 宿主侧配置模板 —— 复制为仓根 `.env` 后按机器实况修改 (cp .env.example .env)
#
# 本文件是"宿主机视角": app/config.py 只读 .env 与 .env.local(机器私有覆盖), 不读
# docker/.env, 所以这里的地址全部指向 docker compose 已发布的宿主端口。
# 容器侧配置(服务名 + /data 卷路径)见 docker/.env.example -> docker/.env。
#
# 密钥红线: 真实密钥不得写在本文件。DEEPSEEK_API_KEY / LANGSMITH_API_KEY / PG_PASSWORD
# 只来自 docker/secrets/<name>.txt (config.py 在宿主机直跑时回退读取) 或真实环境变量。
# 即使本文件被复制/备份, 也不会带走任何凭据。
# ==========================================================================

# ---------- Ollama (仅 embedding / vision 走宿主机; rerank 已迁 TEI) ----------
# 本系统唯一不在 docker 里的依赖
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3

# ---------- 在线 LLM (DeepSeek / 智谱 GLM / ... 经供应商注册表路由) ----------
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 禁止在此填值: 写 docker/secrets/deepseek_api_key.txt (或 export DEEPSEEK_API_KEY)
DEEPSEEK_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 禁止在此填值: 写 docker/secrets/zhipu_api_key.txt (或 export ZHIPU_API_KEY)
ZHIPU_API_KEY=
# 整站模型切换只改这两行: deepseek-flash / glm-5.3-flash / 任意本地 Ollama 模型名;
# 命中注册表前缀走在线 API, 未命中回退 Ollama(容器侧另需 compose 注入, 见 docker/.env)。
LLM_MODEL=deepseek-flash
INTENT_MODEL=deepseek-flash
# 在线 LLM 请求上限与重试次数: 没有墙钟上限的挂死调用会永久占住一个并发闸门;
# 重试取小(供商 429/5xx 时重试风暴只会把故障放大)。
LLM_REQUEST_TIMEOUT=120
LLM_MAX_RETRIES=2
# 供应商注册表(模型前缀 -> 路由), 整体覆盖 config.py 内置默认表; 留空即用代码默认。
# 新增 OpenAI 兼容供应商 = 加前缀条目 + base_url 键 + docker/secrets/<api_key_field>.txt。
# LLM_PROVIDERS_JSON=

# ---------- RAG ----------
KNOWLEDGE_DIR=./data/knowledge
RAG_TOP_K=8
RERANK_TOP_N=4
# compose 服务 tei-rerank 的已发布宿主端口; 权重需预下载到 data/tei_models (见 README)
TEI_RERANK_URL=http://localhost:8080
RETRIEVAL_SCORE_THRESHOLD=0.4

# ---------- Elasticsearch (compose 服务 elasticsearch 的宿主端口) ----------
ES_URL=http://localhost:9200
ES_INDEX=kb_chunks

# ---------- Assistant ----------
ASSISTANT_HOST=0.0.0.0
# 宿主直跑网关的端口, 与 compose 里 assistant 的发布端口保持一致(默认 18000)。
# Windows winnat/Hyper-V 会把 7956-8055 等端口段列进 TCP 排除范围, :8000 常常无法 bind,
# 详见 docker/docker-compose.yml 顶部约定。vite 代理目标读的就是这个值。
ASSISTANT_PORT=18000
MEMORY_MAX_TURNS=10
MEMORY_SUMMARY_THRESHOLD=20
LLM_THINKING_ENABLED=true
LLM_REASONING_EFFORT=high
STREAM_BUFFER_TTL=600
# 多任务并行(复合问法拆分): MULTI_TASK_ENABLED=false 可完全回退单意图路由
MULTI_TASK_ENABLED=true
MULTI_TASK_MIN_CHARS=8
MULTI_TASK_MAX_SUBTASKS=3
MULTI_TASK_PARALLELISM=3
MULTI_TASK_SUBTASK_TIMEOUT=45
# 同步活下沉的线程池上限(asyncio.to_thread 默认 min(32,cpu+4), anyio 默认 40):
# 文档生成/文档解析/PIL 图片归一化与文件下载路由全走这两个池。
THREAD_POOL_TOKENS=64

# ---------- 并发容量: 连接池与下游上限(与 PG max_connections 一起算账) ----------
# 这一整段都是"百人共用一个网关进程"的容量参数, 不是功能开关; 调小后的现象是
# 静默排队到超时而不是报错。调大 PG_*_POOL* 时必须回来对照 docker-compose.yml 里
# postgres 的 max_connections=200(口径见 app/config.py::pg_pool_size 注释)。
REDIS_MAX_CONNECTIONS=100
# ES 检索侧秒级超时与稀疏通道并发上限(重建另走宽松一档)
ES_SEARCH_TIMEOUT=3
ES_SEARCH_CONCURRENCY=32
ES_REBUILD_TIMEOUT=120
# Ollama embedding: 查询档(热路径)与批量档(入库)共用一个连接池
EMBEDDING_TIMEOUT=60
EMBEDDING_QUERY_TIMEOUT=10
EMBEDDING_MAX_CONNECTIONS=32
EMBEDDING_QUERY_CONCURRENCY=8
# MCP 工具清单缓存 TTL: 每次 tool_call 都重新 discover 会打满 MCP server
MCP_TOOLS_TTL=300
# A2A 委派超时与共享连接池上限
A2A_TIMEOUT=120
A2A_CONNECT_TIMEOUT=10
A2A_MAX_CONNECTIONS=64
A2A_MAX_KEEPALIVE=16
# SSE 缓冲区与背压闸门: 超上限直接 503(+Retry-After), 而不是让所有人集体超时
STREAM_MAX_EVENTS=4000
STREAM_MAX_CONCURRENT_RUNS=200
STREAM_MAX_BUFFERS=2000
# Redis 不可用时降级为进程内会话记忆的会话数上限(LRU 淘汰, 防无界涨内存)
SESSION_MEMORY_LOCAL_MAX=5000

# ---------- 记忆层: Session Memory / Working State Checkpoint (compose 服务 redis) ----------
# redis 必须是 redis-stack-server(带 RedisJSON + RediSearch), 否则 checkpointer 静默退回内存
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379/0
SESSION_MEMORY_TTL=3600
CHECKPOINT_ENABLED=true

# ---------- 长期记忆: Vector(pgvector) + Graph(compose 服务 neo4j) ----------
# 注意两个"代码默认值与本例相反"的开关: LONG_TERM_MEMORY_ENABLED 与 DOC_KG_ENABLED
# 在 app/config.py 里故意默认 false(宿主轨直跑时不想顺手写库/烧 token), 本例的 true
# 是"容器全栈部署的建议值"。没拷 .env 直接 `python main.py` 起时这两项(连同下面
# 未列的项)就是 false, 表现为"长期记忆与文档图谱完全是空的"而不报错 —— 网关启动时会
# 打一行能力开关摘要并对未开启项告警, 以那行为准。
LONG_TERM_MEMORY_ENABLED=true
GRAPH_MEMORY_ENABLED=true
# 对接 compose 服务 neo4j 的已发布 bolt 端口 (原 7687 已落进本机 winnat 排除段 7630-7729,
# 由 docker/.env 的 NEO4J_BOLT_HOST_PORT 抬到 17687; HTTP 控制台在 17474)
NEO4J_URI=bolt://localhost:17687
# NEO4J_AUTH=none 时留空
NEO4J_USER=
NEO4J_PASSWORD=

# ---------- 个人级记忆 ----------
PERSONAL_MEMORY_ENABLED=true
PROFILE_MAX_CHARS=400
PROFILE_HISTORY_MAX_ENTRIES=10
PROFILE_CURRENT_GRACE_DAYS=90
MEMORY_PREFERENCE_TOP_K=3
MEMORY_HABIT_TOP_K=3
MEMORY_EPISODE_TOP_K=2
MEMORY_KNOWLEDGE_TOP_K=3
EPISODIC_WINDOW_DAYS=30
MEMORY_DECAY_DAYS=90
MEMORY_REFLECT_MIN_EPISODES=3
MEMORY_OBSERVATION_WINDOW_DAYS=7
# 显式知识记录(知识桶唯一写入口): 命中触发词才提炼落库; 蒸馏已下线, 上项仅保留兼容。
MEMORY_RECORD_ENABLED=true
MEMORY_RECORD_KEYWORDS=记一下,记住,帮我记,记下来,别忘了

# ---------- 缓存层 ----------
CACHE_ENABLED=true
PROMPT_CACHE_TTL=300
RETRIEVAL_CACHE_TTL=300
TOOL_CACHE_TTL=30

# ---------- MCP Servers / A2A Agents (compose 已发布宿主端口) ----------
HR_MCP_URL=http://localhost:18001/mcp
FINANCE_MCP_URL=http://localhost:18002/mcp
ANALYTICS_MCP_URL=http://localhost:18005/mcp
PROCUREMENT_MCP_URL=http://localhost:18006/mcp
HR_AGENT_URL=http://localhost:9001
FINANCE_AGENT_URL=http://localhost:9002
ANALYST_AGENT_URL=http://localhost:9005
CONTRACT_AGENT_URL=http://localhost:9006

# ---------- 进程内 web 工具 (联网检索/抓取, app/tools/web.py) ----------
# ddgs 免密默认; tavily/serper 密钥只写 docker/secrets/<name>.txt, 这里留空。
WEB_SEARCH_PROVIDER=ddgs
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT=10
WEB_SEARCH_CACHE_TTL=300
# 检索出口代理(仅作用于 search_web, 不作用于 fetch_url): 大陆网络下 ddgs 默认引擎直连不可达,
# 需经能翻出去的 HTTP(S) 代理。宿主直跑填 http://127.0.0.1:<port>; 不受限网络留空(直连)。
WEB_SEARCH_PROXY=
TAVILY_API_KEY=
SERPER_API_KEY=
# 抓取护栏: 逗号分隔域名白名单(空=不启用, 仅靠 SSRF 拒内网)。
WEB_FETCH_ALLOWLIST=
WEB_FETCH_TIMEOUT=15
WEB_FETCH_MAX_BYTES=2000000
WEB_FETCH_MAX_CHARS=8000
WEB_FETCH_MAX_REDIRECTS=3

# ---------- 进程内文档生成 (app/tools/docgen.py: Word/Excel/PPT/PDF/MD/图片) ----------
DOCGEN_MAX_BYTES=20000000
DOCGEN_RETENTION_HOURS=24
# 文档内嵌图片治理: 单张原图字节上限 + 归一化后最长边像素。
DOCGEN_IMAGE_MAX_BYTES=8000000
DOCGEN_IMAGE_MAX_EDGE=1600
# 下载链接前缀: 空则返回相对路径 /api/files/<token>/<file>(SPA 同源内可直接点)。
PUBLIC_BASE_URL=

# ---------- 分析产物 (Analyst_Agent 图表/报告) ----------
# 宿主直跑网关时读 ./data/reports; 与容器侧 /data/reports 同一 ../data 卷。
REPORT_DIR=./data/reports

# ---------- Security ----------
AUDIT_LOG_PATH=./logs/audit.jsonl

# ---------- LangSmith / LangGraph Studio (仅开发机按需开启) ----------
# 开启后对话 trace 会上传到 LangSmith 云端; 容器侧由 docker/.env + compose 锁死 false。
LANGSMITH_TRACING=false
# 禁止在此填值: 写 docker/secrets/langsmith_api_key.txt (或 export LANGSMITH_API_KEY)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mxi-assistant
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# ---------- Langfuse (自托管可观测, 与 LangSmith 并存的独立开关) ----------
# 宿主轨默认指向已发布的 langfuse-web(http://localhost:18100); 开启前需先用
# `docker compose -f docker/docker-compose.yml --profile langfuse up -d` 把栈起起来。
# 容器侧的 LANGFUSE_BASE_URL 由 compose 锁成服务名, 不读本文件(见 docker/.env.example)。
LANGFUSE_ENABLED=false
# 禁止在此填值: 写 docker/secrets/langfuse_api_key.txt (两行: 第一行 sk-lf-... / 第二行 pk-lf-...)
LANGFUSE_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=http://localhost:18100
LANGFUSE_PROJECT=mxi-assistant
LANGFUSE_ENVIRONMENT=development

# ---------- 统一存储层: PostgreSQL (compose 服务 postgres) ----------
# 密码不填本文件: 走 docker/secrets/pg_password.txt 或环境变量 PG_PASSWORD
# DATABASE_URL 非空时优先于下面的 PG_* 字段 (必须为 postgresql+asyncpg://...)
DATABASE_URL=
PG_HOST=localhost
PG_PORT=5432
PG_USER=mxi
PG_DATABASE=mxi
PG_SSLMODE=disable
PG_CONNECT_TIMEOUT=10
# 连接池容量: 不给就是 SQLAlchemy 默认 5+10(=15 条), 百人共用一个进程时所有 DB
# 路径都在这排 30s 队然后被代码当"DB 抖动"吞掉。同步池取小是因为它是"网关 + 每个
# mcp/agent 进程各建一份"这份预算里的乘数项。
PG_POOL_SIZE=30
PG_MAX_OVERFLOW=20
PG_POOL_TIMEOUT=15
PG_SYNC_POOL_SIZE=5
PG_SYNC_MAX_OVERFLOW=5
PG_STATEMENT_TIMEOUT_MS=5000
EMBEDDING_DIM=1024
UPSERT_BATCH_SIZE=500

# ---------- 文档上传 ----------
UPLOAD_DIR=./data/uploads
UPLOAD_MAX_MB=50
PARENT_CHUNK_MAX=1200

# ---------- 文档正文外置存储: MongoDB (compose 服务 mongo) ----------
MONGO_ENABLED=true
MONGO_URL=mongodb://localhost:27017
MONGO_DATABASE=mxi
MONGO_MAX_POOL_SIZE=50
MONGO_SERVER_SELECTION_MS=3000
MONGO_BODY_MAX_BYTES=15000000
MONGO_BATCH_PAGE_SIZE=500

# ---------- 入库 ----------
# normalize_text() 行为变更时必须递增此值 (否则已入库 offset 集体失效)
NORMALIZER_VERSION=n1
RAG_INCREMENTAL_INGEST=true
# 文档知识图谱(GraphRAG)总开关, 复用 neo4j
DOC_KG_ENABLED=true
# 单篇文档落库的关系条数硬上限(提示词只软约束, 代码侧按此截断)
KG_MAX_RELATIONS_PER_DOC=40
# 受控关系词表开关: false 即退回关系词原样入库(词表本体在 app/kg/vocab.py)
KG_RELATION_VOCAB_ENABLED=true

# ---------- MinerU OCR (compose 服务 mineru, 需 --profile mineru 启动) ----------
MINERU_BASE_URL=http://localhost:8888
MINERU_BACKEND=pipeline
MINERU_TIMEOUT=300
